{
  "name": "aeonpass-mcp",
  "version": "1.0.0",
  "description": "MCP server for the Aeon Pass platform API",
  "type": "module",
  "bin": {
    "aeonpass-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "dev:http": "tsx src/node.ts",
    "start": "node dist/index.js",
    "serve": "node dist/node.js",
    "check:api": "node scripts/check-api.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.0",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "hono": "^4.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
